# Live test against a Wazuh single-node running in Docker on the same machine.
# Copy to testing/local-wazuh.env and fill in the password.
POSTGRES_USER=user123
POSTGRES_PASSWORD=test_only_password
POSTGRES_DB=security_inc

API_PORT=8000
API_PUBLISH_PORT=8000

OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=300

# Wazuh publishes the indexer on the host's port 9200; host.docker.internal reaches the host
# from inside the detector container (also on Linux, via extra_hosts in docker-compose.yml).
INDEXER_URL=https://host.docker.internal:9200
INDEXER_USER=redflags_ro           # or admin while testing
INDEXER_PASSWORD=<password>
INDEXER_INDEX=wazuh-alerts-4.x-*
# The Wazuh demo certificate is issued for "wazuh.indexer", not host.docker.internal, so hostname
# verification fails. Acceptable only for a local test.
INDEXER_VERIFY_TLS=false
INDEXER_POLL_INTERVAL=10
# Keep only sshd/apache/nginx logs (terms match on decoder.name / rule.groups; empty = all)
INDEXER_DECODERS=sshd,apache-accesslog,nginx-accesslog
INDEXER_GROUPS=sshd,syslog,web-accesslog
INDEXER_LOOKBACK_MIN=60            # first run: analyze the last hour

DETECTION_THRESHOLD=0.85
REQUIRE_INDICATOR_FOR_ANOMALY=true
PROMPT_EXAMPLES=false
MIN_RULE_LEVEL=0
RULE_ID_DENYLIST=
