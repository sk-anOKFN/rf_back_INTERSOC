INDEXER_DECODERS=
INDEXER_GROUPS=
# Mock replay test. Copy to testing/test.env (no real secrets here).
POSTGRES_USER=user123
POSTGRES_PASSWORD=test_only_password
POSTGRES_DB=security_inc

API_PORT=8000
API_PUBLISH_PORT=8000

OLLAMA_MODEL=llama3.2:latest
OLLAMA_TIMEOUT=300                 # CPU inference can take 10-30 s per alert

# Points at the mock-indexer container from docker-compose.test.yml
INDEXER_URL=http://mock-indexer:9200
INDEXER_USER=redflags_ro
INDEXER_PASSWORD=test-only-password
INDEXER_POLL_INTERVAL=5
INDEXER_LOOKBACK_MIN=30
TEST_FIXTURE=sample_alerts.ndjson  # file in testing/fixtures/

DETECTION_THRESHOLD=0.85
REQUIRE_INDICATOR_FOR_ANOMALY=true
PROMPT_EXAMPLES=false
RULE_ID_DENYLIST=19007             # SCA checks in the sample fixture
